<x-app-layout>
    <x-slot name="header">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>
                <h2 style="font-size:24px;font-weight:900;color:#0f172a;letter-spacing:-0.03em;margin:0 0 4px;">Order Management</h2>
                <p style="font-size:13px;color:#94a3b8;font-weight:500;margin:0;">Manage and track customer laundry states</p>
            </div>
            <a href="{{ route('pos.index') }}" style="display:flex;align-items:center;gap:7px;padding:10px 18px;background:#1d4ed8;color:white;font-size:13px;font-weight:700;border-radius:10px;text-decoration:none;box-shadow:0 2px 10px rgba(29,78,216,0.3);transition:all 0.15s;"
                onmouseover="this.style.background='#1e40af'" onmouseout="this.style.background='#1d4ed8'">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
                New POS Order
            </a>
        </div>
    </x-slot>

    @if(session('success'))
        <div style="margin-bottom:16px;padding:12px 18px;background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;font-size:13px;font-weight:700;color:#16a34a;">
            ✓ {{ session('success') }}
        </div>
    @endif

    <div x-data="{
        currentTab: 'all',
        selectedOrders: [],
        showBulkModal: false,
        bulkStatus: 'received',
        showReverseModal: false,
        reverseOrderId: null,
        reversePassword: '',
        reverseError: '',
        statusModalOpen: false,
        selectedOrder: null,
        newStatus: '',
        selectedCubby: '',
        ordersList: JSON.parse(atob('{{ base64_encode(json_encode($orders)) }}')),

        toggleSelectAll(e) {
            if (e.target.checked) {
                this.selectedOrders = this.filteredOrders.map(o => o.id);
            } else {
                this.selectedOrders = [];
            }
        },

        get filteredOrders() {
            if (this.currentTab === 'all') return this.ordersList;
            return this.ordersList.filter(o => o.status === this.currentTab);
        },

        get counts() {
            return {
                all: this.ordersList.length,
                received: this.ordersList.filter(o => o.status === 'received').length,
                done: this.ordersList.filter(o => o.status === 'done').length,
                delivered: this.ordersList.filter(o => o.status === 'delivered').length
            };
        },

        openReverse(orderId) {
            this.reverseOrderId = orderId;
            this.reversePassword = '';
            this.reverseError = '';
            this.showReverseModal = true;
        },

        async submitReverse() {
            this.reverseError = '';
            try {
                const res = await fetch(`/orders/${this.reverseOrderId}/reverse`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]').content
                    },
                    body: JSON.stringify({ password: this.reversePassword })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    this.reverseError = data.message || 'Verification failed';
                }
            } catch (err) {
                this.reverseError = 'Error connecting to server';
            }
        },

        async submitBulkUpdate() {
            if (this.selectedOrders.length === 0) return;
            try {
                const res = await fetch(`/orders/bulk-status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]').content
                    },
                    body: JSON.stringify({
                        order_ids: this.selectedOrders,
                        status: this.bulkStatus
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Bulk update failed');
                }
            } catch (err) {
                alert('Connection error');
            }
        }
    }" style="background:white;border-radius:16px;border:1px solid #e2e8f0;box-shadow:0 1px 6px rgba(0,0,0,0.04);overflow:hidden;display:flex;flex-direction:column;gap:0;">

        <!-- Filter Tabs & Actions Header -->
        <div style="padding:24px 32px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;background:#f8fafc;">
            <!-- Tabs -->
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                <button @click="currentTab = 'all'" :style="currentTab === 'all' ? 'background:#1d4ed8;color:white;box-shadow:0 4px 12px rgba(29,78,216,0.25);border:1.5px solid #1d4ed8;' : 'background:white;color:#64748b;border:1.5px solid #e2e8f0;'"
                    style="padding:10px 24px;font-size:14px;font-weight:800;border-radius:12px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:8px;">
                    All <span :style="currentTab === 'all' ? 'background:rgba(255,255,255,0.25);color:white;' : 'background:#f1f5f9;color:#475569;'" style="font-size:12px;font-weight:800;padding:2px 10px;border-radius:999px;transition:all 0.2s;" x-text="counts.all"></span>
                </button>
                <button @click="currentTab = 'received'" :style="currentTab === 'received' ? 'background:#1d4ed8;color:white;box-shadow:0 4px 12px rgba(29,78,216,0.25);border:1.5px solid #1d4ed8;' : 'background:white;color:#64748b;border:1.5px solid #e2e8f0;'"
                    style="padding:10px 24px;font-size:14px;font-weight:800;border-radius:12px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:8px;">
                    Received <span :style="currentTab === 'received' ? 'background:rgba(255,255,255,0.25);color:white;' : 'background:#f1f5f9;color:#475569;'" style="font-size:12px;font-weight:800;padding:2px 10px;border-radius:999px;transition:all 0.2s;" x-text="counts.received"></span>
                </button>
                <button @click="currentTab = 'done'" :style="currentTab === 'done' ? 'background:#1d4ed8;color:white;box-shadow:0 4px 12px rgba(29,78,216,0.25);border:1.5px solid #1d4ed8;' : 'background:white;color:#64748b;border:1.5px solid #e2e8f0;'"
                    style="padding:10px 24px;font-size:14px;font-weight:800;border-radius:12px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:8px;">
                    Done <span :style="currentTab === 'done' ? 'background:rgba(255,255,255,0.25);color:white;' : 'background:#f1f5f9;color:#475569;'" style="font-size:12px;font-weight:800;padding:2px 10px;border-radius:999px;transition:all 0.2s;" x-text="counts.done"></span>
                </button>
                <button @click="currentTab = 'delivered'" :style="currentTab === 'delivered' ? 'background:#1d4ed8;color:white;box-shadow:0 4px 12px rgba(29,78,216,0.25);border:1.5px solid #1d4ed8;' : 'background:white;color:#64748b;border:1.5px solid #e2e8f0;'"
                    style="padding:10px 24px;font-size:14px;font-weight:800;border-radius:12px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:8px;">
                    Delivered <span :style="currentTab === 'delivered' ? 'background:rgba(255,255,255,0.25);color:white;' : 'background:#f1f5f9;color:#475569;'" style="font-size:12px;font-weight:800;padding:2px 10px;border-radius:999px;transition:all 0.2s;" x-text="counts.delivered"></span>
                </button>
            </div>

            <!-- Search and Bulk Action button -->
            <div style="display:flex;align-items:center;gap:12px;">
                <form action="{{ route('orders.index') }}" method="GET" style="display:flex;gap:8px;margin:0;">
                    <input type="text" name="q" value="{{ request('q') }}" placeholder="Search ID or phone…"
                        style="padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:9px;font-size:13px;font-weight:600;outline:none;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                    <button type="submit" style="padding:8px 14px;background:white;border:1.5px solid #e2e8f0;border-radius:9px;font-size:13px;font-weight:700;color:#334155;cursor:pointer;">Search</button>
                </form>

                <button x-show="selectedOrders.length > 0" @click="showBulkModal = true"
                    style="padding:8.5px 16px;background:#16a34a;color:white;font-size:13px;font-weight:800;border:none;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    Bulk Update (<span x-text="selectedOrders.length"></span>)
                </button>
            </div>
        </div>

        <!-- Table Container -->
        <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;text-align:left;font-size:13px;color:#334155;">
                <thead>
                    <tr style="background:#f8fafc;border-bottom:1px solid #f1f5f9;">
                        <th style="padding:22px 32px;width:40px;">
                            <input type="checkbox" @change="toggleSelectAll($event)" :checked="selectedOrders.length === filteredOrders.length && filteredOrders.length > 0" style="cursor:pointer;">
                        </th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;">Order ID & Customer</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;">Order Date</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;">Pickup Date</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;">Status</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;">Cubbet (Location)</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;text-align:right;">Price</th>
                        <th style="padding:22px 32px;font-weight:800;color:#0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.05em;text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="order in filteredOrders" :key="order.id">
                        <tr style="border-bottom:1px solid #f1f5f9;transition:all 0.1s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                            <td style="padding:22px 32px;">
                                <input type="checkbox" :value="order.id" x-model="selectedOrders" style="cursor:pointer;">
                            </td>
                            <td style="padding:22px 32px;">
                                <a :href="'/orders/' + order.id" style="font-size:14px;font-weight:800;color:#1d4ed8;text-decoration:none;display:block;" x-text="order.order_number"></a>
                                <div style="margin-top:4px;display:flex;flex-direction:column;gap:1px;">
                                    <span style="font-weight:700;color:#0f172a;" x-text="order.customer ? order.customer.name : 'Walk-in Customer'"></span>
                                    <span style="font-size:11px;color:#64748b;font-weight:600;" x-text="order.customer ? order.customer.phone : '0000000000'"></span>
                                </div>
                            </td>
                            <td style="padding:22px 32px;font-weight:600;color:#475569;">
                                <span style="display:block;" x-text="new Date(order.created_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})"></span>
                                <span style="font-size:11px;color:#94a3b8;font-weight:500;" x-text="new Date(order.created_at).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'})"></span>
                            </td>
                            <td style="padding:22px 32px;font-weight:600;color:#475569;">
                                <template x-if="order.due_date">
                                    <div>
                                        <span style="display:block;" x-text="new Date(order.due_date).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})"></span>
                                        <span style="font-size:11px;color:#94a3b8;font-weight:500;" x-text="new Date(order.due_date).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'})"></span>
                                    </div>
                                </template>
                                <template x-if="!order.due_date">
                                    <span style="color:#cbd5e1;font-style:italic;font-size:12px;">No promised date</span>
                                </template>
                            </td>
                            <td style="padding:22px 32px;">
                                <span :style="
                                    order.status === 'received' ? 'background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe;' :
                                    order.status === 'done' ? 'background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;' :
                                    order.status === 'delivered' ? 'background:#f8fafc;color:#64748b;border:1px solid #e2e8f0;' :
                                    'background:#fef2f2;color:#dc2626;border:1px solid #fecaca;'
                                " style="font-size:11px;font-weight:800;padding:4px 9px;border-radius:6px;text-transform:uppercase;letter-spacing:0.04em;">
                                    <span x-text="order.status"></span>
                                </span>
                            </td>
                            <td style="padding:22px 32px;font-weight:700;">
                                <template x-if="order.cubby && order.cubby.cubby">
                                    <span style="color:#4f46e5;" x-text="order.cubby.cubby.name"></span>
                                </template>
                                <template x-if="!(order.cubby && order.cubby.cubby)">
                                    <span style="color:#94a3b8;font-style:italic;font-weight:500;">Not assigned</span>
                                </template>
                            </td>
                            <td style="padding:22px 32px;text-align:right;font-weight:800;color:#0f172a;font-size:14px;" x-text="'Rs.' + parseFloat(order.total).toFixed(2)"></td>
                            <td style="padding:22px 32px;text-align:center;">
                                <div style="display:inline-flex;gap:6px;align-items:center;">
                                    <a :href="'/orders/' + order.id" style="padding:5px 10px;background:#eff6ff;color:#1d4ed8;border:1.5px solid #bfdbfe;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;transition:all 0.15s;" onmouseover="this.style.background='#dbeafe'" onmouseout="this.style.background='#eff6ff'">View</a>
                                    <a :href="'/orders/' + order.id + '/print'" target="_blank" style="padding:5px 10px;background:white;color:#334155;border:1.5px solid #e2e8f0;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;transition:all 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'">Print</a>
                                    
                                    <template x-if="order.status !== 'delivered' && order.status !== 'cancelled'">
                                        <button @click="selectedOrder = order; newStatus = order.status; statusModalOpen = true"
                                            style="padding:5px 10px;background:#f0fdf4;color:#16a34a;border:1.5px solid #bbf7d0;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#f0fdf4'">
                                            Update
                                        </button>
                                    </template>
                                    
                                    <button @click="openReverse(order.id)" style="padding:5px 10px;background:#fef2f2;color:#dc2626;border:1.5px solid #fecaca;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='#fef2f2'">
                                        Reverse
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="filteredOrders.length === 0">
                        <td colspan="8" style="padding:40px;text-align:center;color:#94a3b8;font-size:14px;font-weight:500;">
                            No orders found matching this status or query.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- ── Bulk Status Update Modal ── -->
        <div x-show="showBulkModal" style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,0.4);backdrop-filter:blur(4px);">
            <div style="background:white;border-radius:20px;box-shadow:0 25px 50px rgba(0,0,0,0.2);width:100%;max-width:400px;overflow:hidden;" @click.away="showBulkModal = false">
                <div style="padding:20px 24px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;">
                    <h3 style="font-size:16px;font-weight:900;color:#0f172a;margin:0;">Bulk Update Orders</h3>
                    <button @click="showBulkModal = false" style="background:none;border:none;cursor:pointer;color:#94a3b8;">✕</button>
                </div>
                <div style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;">
                    <div>
                        <label style="display:block;font-size:11.5px;font-weight:700;color:#374151;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em;">Target Status</label>
                        <select x-model="bulkStatus" style="width:100%;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;outline:none;background:white;">
                            <option value="received">Received</option>
                            <option value="done">Done</option>
                            <option value="delivered">Delivered</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div style="display:flex;gap:10px;">
                        <button @click="showBulkModal = false" style="flex:1;padding:11px;background:#f8fafc;color:#64748b;font-size:13px;font-weight:700;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">Cancel</button>
                        <button @click="submitBulkUpdate" style="flex:1;padding:11px;background:#16a34a;color:white;font-size:13px;font-weight:800;border:none;border-radius:10px;cursor:pointer;">Apply Changes</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Reverse Authorization Modal ── -->
        <div x-show="showReverseModal" style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,0.4);backdrop-filter:blur(4px);">
            <div style="background:white;border-radius:20px;box-shadow:0 25px 50px rgba(0,0,0,0.2);width:100%;max-width:400px;overflow:hidden;" @click.away="showReverseModal = false">
                <div style="padding:20px 24px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;">
                    <h3 style="font-size:16px;font-weight:900;color:#0f172a;margin:0;">Reverse Bill Authorization</h3>
                    <button @click="showReverseModal = false" style="background:none;border:none;cursor:pointer;color:#94a3b8;">✕</button>
                </div>
                <div style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;">
                    <p style="font-size:12.5px;color:#64748b;margin:0;font-weight:500;line-height:1.4;">Enter the admin or super admin password to reverse this bill and set its status back to received.</p>
                    <div>
                        <label style="display:block;font-size:11.5px;font-weight:700;color:#374151;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em;">Admin Password</label>
                        <input type="password" x-model="reversePassword" placeholder="••••••••"
                            style="width:100%;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;outline:none;"
                            onfocus="this.style.borderColor='#ef4444'" onblur="this.style.borderColor='#e2e8f0'">
                    </div>
                    <div x-show="reverseError" style="font-size:12px;color:#dc2626;font-weight:700;" x-text="reverseError"></div>
                    <div style="display:flex;gap:10px;">
                        <button @click="showReverseModal = false" style="flex:1;padding:11px;background:#f8fafc;color:#64748b;font-size:13px;font-weight:700;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">Cancel</button>
                        <button @click="submitReverse" style="flex:1;padding:11px;background:#ef4444;color:white;font-size:13px;font-weight:800;border:none;border-radius:10px;cursor:pointer;">Authorize Reverse</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Status Update Modal ── -->
        <div x-show="statusModalOpen" style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,0.4);backdrop-filter:blur(4px);">
            <div style="background:white;border-radius:20px;box-shadow:0 25px 50px rgba(0,0,0,0.2);width:100%;max-width:440px;overflow:hidden;" @click.away="statusModalOpen = false">
                <div style="padding:20px 24px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;">
                    <h3 style="font-size:16px;font-weight:900;color:#0f172a;margin:0;" x-text="'Update Order #' + selectedOrder?.order_number"></h3>
                    <button @click="statusModalOpen = false" style="background:none;border:none;cursor:pointer;color:#94a3b8;">✕</button>
                </div>
                <form x-bind:action="'/orders/' + selectedOrder?.id + '/status'" method="POST" style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;margin:0;">
                    @csrf
                    <div>
                        <label style="display:block;font-size:11.5px;font-weight:700;color:#374151;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em;">New Status</label>
                        <select name="status" x-model="newStatus" style="width:100%;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;outline:none;background:white;">
                            <option value="received">Received</option>
                            <option value="done">Done</option>
                            <option value="delivered">Delivered</option>
                        </select>
                    </div>

                    <div x-show="newStatus === 'done'" style="padding:12px;background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:10px;">
                        <label style="display:block;font-size:11.5px;font-weight:700;color:#3730a3;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em;">Assign Cubbet (Location)</label>
                        <select name="cubby_id" style="width:100%;padding:8px 12px;border:1.5px solid #c7d2fe;border-radius:8px;font-size:13px;font-weight:600;outline:none;background:white;color:#3730a3;">
                            <option value="" style="color:#64748b;">-- Select Empty Cubbet --</option>
                            @foreach($cubbies as $cubby)
                                <option value="{{ $cubby->id }}" style="color:#0f172a;">{{ $cubby->name }}</option>
                            @endforeach
                        </select>
                        <p style="font-size:11px;color:#4f46e5;margin:6px 0 0;font-weight:600;">A WhatsApp message will be sent to the customer automatically.</p>
                    </div>

                    <div x-show="newStatus === 'delivered'" style="padding:12px;background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;">
                        <p style="font-size:12px;color:#16a34a;margin:0;font-weight:600;line-height:1.4;">Payment will be marked as settled and a Thank You WhatsApp message will be sent.</p>
                    </div>

                    <div style="display:flex;gap:10px;">
                        <button type="button" @click="statusModalOpen = false" style="flex:1;padding:11px;background:#f8fafc;color:#64748b;font-size:13px;font-weight:700;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">Cancel</button>
                        <button type="submit" style="flex:1;padding:11px;background:#1d4ed8;color:white;font-size:13px;font-weight:800;border:none;border-radius:10px;cursor:pointer;">Save Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</x-app-layout>
