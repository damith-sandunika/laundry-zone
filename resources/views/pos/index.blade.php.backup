<x-app-layout>

    <div x-data="posSystem()" style="display:flex;gap:24px;height:calc(100vh - 72px);padding:24px;">

        <!-- ===================== Left: Services ===================== -->
        <div style="flex:1.6;background:white;border-radius:20px;border:1px solid #e2e8f0;box-shadow:0 2px 12px rgba(0,0,0,0.05);overflow:hidden;display:flex;flex-direction:column;">
            <!-- Search bar -->
            <div style="padding:20px 28px;border-bottom:1px solid #f1f5f9;background:#f8fafc;">
                <div style="position:relative;">
                    <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);" width="15" height="15" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" x-model="searchQuery" placeholder="Search laundry services…"
                        style="width:100%;padding:11px 14px 11px 38px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:14px;font-weight:600;color:#0f172a;background:white;outline:none;box-sizing:border-box;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                </div>
            </div>

            <!-- Services Grid -->
            <div style="flex:1;overflow-y:auto;padding:24px 28px;">
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
                    <template x-for="(service,i) in filteredServices" :key="service.id">
                        <button @click="addToCart(service)"
                            :style="`background:${['#eff6ff','#f0fdf4','#fdf4ff','#fff7ed','#f0fdfa','#fef2f2'][i%6]};border:2px solid ${['#bfdbfe','#bbf7d0','#e9d5ff','#fed7aa','#99f6e4','#fecaca'][i%6]};`"
                            style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px 14px;border-radius:16px;cursor:pointer;transition:all 0.18s;text-align:center;gap:8px;"
                            onmouseover="this.style.transform='scale(1.04)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'"
                            onmouseout="this.style.transform='scale(1)';this.style.boxShadow='none'">
                            <span style="font-size:14px;font-weight:800;color:#0f172a;line-height:1.3;" x-text="service.name"></span>
                            <span style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.05em;" x-text="service.price_type === 'per_kg' ? 'Per KG' : 'Per Item'"></span>
                            <span style="font-size:16px;font-weight:900;color:#1d4ed8;" x-text="'Rs.' + parseFloat(service.base_price).toFixed(2)"></span>
                        </button>
                    </template>
                    <div x-show="filteredServices.length === 0" style="grid-column:1/-1;padding:40px;text-align:center;font-size:13px;color:#94a3b8;font-weight:500;">
                        No services matched your search.
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== Right: Order Panel ===================== -->
        <div style="flex:1;background:white;border-radius:20px;border:1px solid #e2e8f0;box-shadow:0 2px 12px rgba(0,0,0,0.05);display:flex;flex-direction:column;overflow:hidden;">

            <!-- Customer Section -->
            <div style="padding:20px 24px;border-bottom:2px solid #f1f5f9;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                    <span style="font-size:11px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.08em;">Customer</span>
                    <button @click="showAddCustomerModal = true"
                        style="font-size:11.5px;font-weight:700;padding:6px 12px;background:#f0fdf4;border:1.5px solid #86efac;color:#16a34a;border-radius:8px;cursor:pointer;transition:all 0.15s;"
                        onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#f0fdf4'">
                        + New Customer
                    </button>
                </div>

                <!-- Search customers -->
                <div style="position:relative;">
                    <svg style="position:absolute;left:11px;top:50%;transform:translateY(-50%);" width="13" height="13" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" x-model="customerSearch" @input="filterCustomers" @focus="showCustDropdown = true" @click.away="showCustDropdown = false"
                        :placeholder="selectedCustomer ? selectedCustomer.name + ' — ' + selectedCustomer.phone : 'Search by name or phone…'"
                        style="width:100%;padding:9px 32px 9px 32px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#0f172a;outline:none;box-sizing:border-box;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                    <button x-show="selectedCustomer" @click="clearCustomer()" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#94a3b8;">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>

                    <!-- Dropdown -->
                    <div x-show="showCustDropdown && filteredCustomers.length > 0" style="position:absolute;z-index:20;width:100%;margin-top:4px;background:white;border:1.5px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.08);max-height:160px;overflow-y:auto;">
                        <template x-for="cust in filteredCustomers" :key="cust.id">
                            <div @click="selectCustomer(cust)" style="padding:10px 14px;cursor:pointer;border-bottom:1px solid #f8fafc;transition:background 0.1s;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='white'">
                                <p style="font-size:13px;font-weight:700;color:#0f172a;margin:0;" x-text="cust.name"></p>
                                <p style="font-size:11px;color:#64748b;margin:2px 0 0;font-weight:500;" x-text="cust.phone"></p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Selected Customer badge -->
                <div x-show="selectedCustomer" style="margin-top:10px;padding:10px 14px;background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <p style="font-size:13px;font-weight:800;color:#1e40af;margin:0;" x-text="selectedCustomer?.name"></p>
                        <p style="font-size:11px;color:#3b82f6;margin:2px 0 0;font-weight:600;" x-text="selectedCustomer?.phone"></p>
                    </div>
                    <span style="font-size:10px;font-weight:800;background:#dbeafe;color:#1d4ed8;padding:3px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:0.05em;">Selected ✓</span>
                </div>

                <!-- Walk-in notice -->
                <div x-show="!selectedCustomer" style="margin-top:8px;font-size:11.5px;color:#d97706;font-weight:600;">
                    Walk-in customer. Search or create a new one above.
                </div>
            </div>

            <!-- Cart -->
            <div style="flex:1;overflow-y:auto;padding:16px 24px;background:#f8fafc;display:flex;flex-direction:column;gap:12px;">
                <template x-if="cart.length === 0">
                    <div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a3b8;padding:40px 0;">
                        <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="opacity:0.3;margin-bottom:10px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <p style="font-size:13px;font-weight:700;margin:0;">No items added</p>
                        <p style="font-size:11px;margin:4px 0 0;font-weight:500;">Tap a service on the left to add</p>
                    </div>
                </template>

                <template x-for="(item, index) in cart" :key="index">
                    <div style="background:white;padding:16px 18px;border-radius:14px;border:1.5px solid #e2e8f0;box-shadow:0 1px 6px rgba(0,0,0,0.05);">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                            <div style="flex:1;">
                                <h4 style="font-size:13px;font-weight:800;color:#0f172a;margin:0 0 3px;" x-text="item.name"></h4>
                                <p style="font-size:11px;color:#94a3b8;margin:0;font-weight:600;" x-text="'Rs.' + parseFloat(item.base_price).toFixed(2) + (item.price_type === 'per_kg' ? ' /kg' : ' /item')"></p>
                            </div>
                            <button @click="removeFromCart(index)" style="background:none;border:none;cursor:pointer;color:#fca5a5;padding:0 0 0 8px;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#fca5a5'">
                                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                        </div>
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:10px;">
                            <div style="display:flex;align-items:center;border:1.5px solid #e2e8f0;border-radius:8px;overflow:hidden;">
                                <button @click="updateQty(index,-1)" style="padding:4px 10px;background:#f8fafc;border:none;cursor:pointer;font-size:14px;font-weight:800;color:#64748b;">−</button>
                                <input type="number" x-model.number="item.qty" style="width:44px;text-align:center;font-size:13px;font-weight:800;border:none;outline:none;padding:4px 0;background:white;" min="0.5" step="0.5">
                                <button @click="updateQty(index,1)"  style="padding:4px 10px;background:#f8fafc;border:none;cursor:pointer;font-size:14px;font-weight:800;color:#64748b;">+</button>
                            </div>
                            <span style="font-size:15px;font-weight:900;color:#1d4ed8;" x-text="'Rs.' + (item.base_price * item.qty).toFixed(2)"></span>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Totals & Payment -->
            <div style="padding:20px 24px;border-top:2px solid #f1f5f9;background:white;display:flex;flex-direction:column;gap:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;font-weight:600;color:#64748b;">Subtotal</span>
                    <span style="font-size:13px;font-weight:700;color:#334155;" x-text="'Rs.' + subtotal.toFixed(2)"></span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;font-weight:600;color:#64748b;">Discount (Rs.)</span>
                    <input type="number" x-model.number="discount" style="width:80px;text-align:right;font-size:13px;font-weight:700;border:1.5px solid #e2e8f0;border-radius:8px;padding:5px 8px;outline:none;" min="0"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;font-weight:600;color:#64748b;">Pickup Date & Time</span>
                    <input type="datetime-local" x-model="dueDate" style="width:160px;font-size:12px;font-weight:700;border:1.5px solid #e2e8f0;border-radius:8px;padding:5px 8px;outline:none;color:#334155;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding-top:10px;border-top:2px solid #f1f5f9;">
                    <span style="font-size:15px;font-weight:800;color:#0f172a;">Total</span>
                    <span style="font-size:20px;font-weight:900;color:#1d4ed8;" x-text="'Rs.' + total.toFixed(2)"></span>
                </div>

                <!-- Payment Method -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <button @click="paymentMode = 'pay_now'"
                        :style="paymentMode === 'pay_now' ? 'background:#16a34a;color:white;border-color:#16a34a;' : 'background:white;color:#64748b;border-color:#e2e8f0;'"
                        style="font-size:12px;font-weight:800;padding:10px;border-radius:10px;border:2px solid;cursor:pointer;transition:all 0.15s;">
                        Pay Now (Cash)
                    </button>
                    <button @click="paymentMode = 'pay_on_pickup'"
                        :style="paymentMode === 'pay_on_pickup' ? 'background:#ea580c;color:white;border-color:#ea580c;' : 'background:white;color:#64748b;border-color:#e2e8f0;'"
                        style="font-size:12px;font-weight:800;padding:10px;border-radius:10px;border:2px solid;cursor:pointer;transition:all 0.15s;">
                        Pay on Pickup
                    </button>
                </div>

                <button @click="placeOrder" :disabled="cart.length === 0"
                    :style="cart.length === 0 ? 'background:#e2e8f0;color:#94a3b8;cursor:not-allowed;' : 'background:#1d4ed8;color:white;cursor:pointer;'"
                    style="width:100%;padding:13px;font-size:14px;font-weight:800;border:none;border-radius:12px;transition:all 0.15s;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:0.01em;"
                    onmouseover="if(this.style.background!='rgb(226, 232, 240)') this.style.background='#1e40af'"
                    onmouseout="if(this.style.background!='rgb(226, 232, 240)') this.style.background='#1d4ed8'">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    Place Order
                </button>
            </div>
        </div>
    </div>


    <!-- ===================== Add New Customer Modal ===================== -->

    <div x-data="{ open: false }"
         x-on:open-customer-modal.window="open = true"
         x-show="open" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
        <div class="absolute inset-0 bg-black bg-opacity-40" @click="open = false"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md z-10" @click.stop>
            <div class="p-4 border-b border-gray-100">
                <h3 class="font-bold text-gray-800">Add New Customer</h3>
                <p class="text-xs text-gray-500 mt-0.5">Register a new customer and auto-select them for this order</p>
            </div>
            <form id="new-customer-form" class="p-4 space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="nc-name" required placeholder="e.g. Kamal Perera" class="w-full text-sm border-gray-200 rounded focus:border-blue-500 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Phone Number</label>
                    <input type="text" id="nc-phone" required placeholder="e.g. 077 123 4567" class="w-full text-sm border-gray-200 rounded focus:border-blue-500 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Address (Optional)</label>
                    <input type="text" id="nc-address" placeholder="Home address" class="w-full text-sm border-gray-200 rounded focus:border-blue-500 focus:ring-blue-500">
                </div>
            </form>
            <div class="flex gap-2 p-4 pt-0">
                <button @click="open = false" class="flex-1 py-2 border border-gray-200 text-gray-600 text-sm rounded hover:bg-gray-50">Cancel</button>
                <button @click="createAndSelectCustomer(open)" id="save-customer-btn"
                    class="flex-1 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded transition-colors">
                    Save & Select Customer
                </button>
            </div>
        </div>
    </div>

    <!-- ===================== Order Success Modal ===================== -->
    <div x-data="{ show: false, orderId: '', orderNum: '', custName: '', total: '', payMode: '' }"
         x-on:order-placed.window="show = true; orderId = $event.detail.orderId; orderNum = $event.detail.orderNumber; custName = $event.detail.customerName; total = $event.detail.total; payMode = $event.detail.paymentMode"
         x-show="show" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
        <div class="absolute inset-0 bg-black bg-opacity-50"></div>
        <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-sm z-10 text-center p-6" @click.stop>
            <div class="w-14 h-14 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-1">Order Placed!</h3>
            <p class="text-sm text-gray-500 mb-4">The laundry order has been registered successfully.</p>

            <div class="bg-gray-50 rounded-lg p-3 text-left space-y-2 mb-4 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Order #:</span>
                    <span class="font-bold text-blue-700" x-text="orderNum"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Customer:</span>
                    <span class="font-semibold" x-text="custName"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Total:</span>
                    <span class="font-bold text-green-700" x-text="'Rs.' + total"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Payment:</span>
                    <span class="font-semibold" x-text="payMode === 'pay_now' ? 'Paid (Cash)' : 'Pay on Pickup'"></span>
                </div>
            </div>

            <div class="flex gap-2">
                <button @click="show = false" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-lg transition-colors">✓ New Order</button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('posSystem', () => ({
                allServices: @json($services),
                allCustomers: @json($customers),
                searchQuery: '',
                customerSearch: '',
                filteredCustomers: [],
                showCustDropdown: false,
                selectedCustomer: null,
                showAddCustomerModal: false,
                cart: [],
                discount: 0,
                paymentMode: 'pay_now',
                dueDate: '',

                get filteredServices() {
                    if (!this.searchQuery) return this.allServices;
                    return this.allServices.filter(s => s.name.toLowerCase().includes(this.searchQuery.toLowerCase()));
                },

                filterCustomers() {
                    const q = this.customerSearch.toLowerCase();
                    this.filteredCustomers = q.length > 0
                        ? this.allCustomers.filter(c => c.name.toLowerCase().includes(q) || c.phone.includes(q))
                        : this.allCustomers.slice(0, 8);
                    this.showCustDropdown = true;
                },

                selectCustomer(cust) {
                    this.selectedCustomer = cust;
                    this.customerSearch = '';
                    this.showCustDropdown = false;
                },

                clearCustomer() {
                    this.selectedCustomer = null;
                    this.customerSearch = '';
                },

                addToCart(service) {
                    let existing = this.cart.find(i => i.id === service.id);
                    if (existing) { existing.qty += 1; } else { this.cart.push({ ...service, qty: 1 }); }
                },

                removeFromCart(index) { this.cart.splice(index, 1); },

                updateQty(index, change) {
                    let newQty = parseFloat(this.cart[index].qty) + change;
                    if (newQty > 0) this.cart[index].qty = Math.round(newQty * 10) / 10;
                    else this.removeFromCart(index);
                },

                get subtotal() { return this.cart.reduce((s, i) => s + (i.base_price * i.qty), 0); },
                get total() { return Math.max(0, this.subtotal - this.discount); },

                async placeOrder() {
                    if (this.cart.length === 0) return;

                    const payload = {
                        customer_id: this.selectedCustomer ? this.selectedCustomer.id : null,
                        new_customer_name: this.selectedCustomer ? null : 'Walk-in',
                        new_customer_phone: this.selectedCustomer ? null : '0000000000',
                        cart: this.cart,
                        discount: this.discount,
                        payment_mode: this.paymentMode,
                        due_date: this.dueDate
                    };

                    try {
                        const res = await fetch("{{ route('pos.store') }}", {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                            },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();
                        if (data.success) {
                            window.dispatchEvent(new CustomEvent('order-placed', { detail: {
                                orderId: data.order_id,
                                orderNumber: data.order_number,
                                customerName: data.customer_name,
                                total: this.total.toFixed(2),
                                paymentMode: this.paymentMode
                            }}));
                            this.cart = [];
                            this.selectedCustomer = null;
                            this.discount = 0;
                            this.paymentMode = 'pay_now';
                            this.dueDate = '';
                        } else {
                            alert('Order failed: ' + (data.error || 'Unknown error'));
                        }
                    } catch (err) { console.error(err); alert('Network error. Please try again.'); }
                },

                // Called from Save Customer button (outside this Alpine component)
                init() {
                    window.posAddCustomer = (customer) => {
                        this.allCustomers.push(customer);
                        this.selectCustomer(customer);
                    };
                }
            }));
        });

        // Create customer via AJAX
        document.getElementById('save-customer-btn').addEventListener('click', async function() {
            const name = document.getElementById('nc-name').value.trim();
            const phone = document.getElementById('nc-phone').value.trim();
            const address = document.getElementById('nc-address').value.trim();

            if (!name || !phone) { alert('Name and phone are required.'); return; }

            const res = await fetch("{{ route('customers.store') }}", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content },
                body: JSON.stringify({ name, phone, address, source: 'pos' })
            });
            const data = await res.json();
            if (data.success) {
                window.posAddCustomer(data.customer);
                document.getElementById('nc-name').value = '';
                document.getElementById('nc-phone').value = '';
                document.getElementById('nc-address').value = '';
                window.dispatchEvent(new Event('close-customer-modal'));
            } else {
                alert('Failed to save customer.');
            }
        });
    </script>
</x-app-layout>
