<x-app-layout>

    <div x-data="posSystem()" class="flex flex-col lg:flex-row gap-4 p-2 lg:p-4" style="height:calc(100vh - 65px);">

        <!-- ===================== Left: Services ===================== -->
        <div class="flex-1 lg:flex-[1.1] bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col overflow-hidden">
            <!-- Search bar -->
            <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;background:#f8fafc;">
                <div style="position:relative;">
                    <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);" width="15" height="15" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" x-model="searchQuery" placeholder="Search laundry services…"
                        style="width:100%;padding:10px 14px 10px 38px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:14px;font-weight:600;color:#0f172a;background:white;outline:none;box-sizing:border-box;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                </div>
            </div>

            <!-- Services Grid -->
            <div style="flex:1;overflow-y:auto;padding:16px 20px;">
                <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:14px;">
                    <template x-for="(service,i) in filteredServices" :key="service.id">
                        <button @click="addToCart(service)"
                            :style="`background:${['#eff6ff','#f0fdf4','#fdf4ff','#fff7ed','#f0fdfa','#fef2f2'][i%6]};border:2px solid ${['#bfdbfe','#bbf7d0','#e9d5ff','#fed7aa','#99f6e4','#fecaca'][i%6]};`"
                            style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 12px;border-radius:24px;cursor:pointer;transition:all 0.18s;text-align:center;gap:6px;"
                            onmouseover="this.style.transform='scale(1.04)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'"
                            onmouseout="this.style.transform='scale(1)';this.style.boxShadow='none'">
                            <span style="font-size:13px;font-weight:800;color:#0f172a;line-height:1.2;" x-text="service.name"></span>
                            <span style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.05em;" x-text="service.price_type === 'per_kg' ? 'Per KG' : 'Per Item'"></span>
                            <span style="font-size:15px;font-weight:900;color:#1d4ed8;" x-text="'Rs.' + parseFloat(service.base_price).toFixed(2)"></span>
                        </button>
                    </template>
                    <div x-show="filteredServices.length === 0" style="grid-column:1/-1;padding:40px;text-align:center;font-size:13px;color:#94a3b8;font-weight:500;">
                        No services matched your search.
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== Right: Order Panel ===================== -->
        <div class="flex-1 lg:flex-[1.4] bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col overflow-hidden">

            <!-- Customer Section -->
            <div style="padding:16px 20px;border-bottom:2px solid #f1f5f9;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="font-size:11px;font-weight:900;color:#0f172a;text-transform:uppercase;letter-spacing:0.08em;">Order</span>
                    <button @click="$dispatch('open-customer-modal')"
                        style="font-size:11px;font-weight:800;padding:5px 10px;background:#f0fdf4;border:1.5px solid #86efac;color:#16a34a;border-radius:8px;cursor:pointer;transition:all 0.15s;"
                        onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#f0fdf4'">
                        + New Customer
                    </button>
                </div>

                <!-- Search customers -->
                <div style="position:relative;">
                    <svg style="position:absolute;left:11px;top:50%;transform:translateY(-50%);" width="13" height="13" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" x-model="customerSearch" @input="filterCustomers" @focus="showCustDropdown = true" @click.away="showCustDropdown = false"
                        :placeholder="selectedCustomer ? 'Change customer…' : 'Search by name or phone…'"
                        style="width:100%;padding:8px 32px 8px 32px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:12px;font-weight:600;color:#0f172a;outline:none;box-sizing:border-box;"
                        onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                    <button x-show="selectedCustomer" @click="clearCustomer()" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#94a3b8;">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>

                    <!-- Dropdown -->
                    <div x-show="showCustDropdown && filteredCustomers.length > 0" style="position:absolute;z-index:20;width:100%;margin-top:4px;background:white;border:1.5px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.08);max-height:160px;overflow-y:auto;">
                        <template x-for="cust in filteredCustomers" :key="cust.id">
                            <div @click="selectCustomer(cust)" style="padding:10px 14px;cursor:pointer;border-bottom:1px solid #f8fafc;transition:background 0.1s;" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='white'">
                                <p style="font-size:12px;font-weight:800;color:#0f172a;margin:0;" x-text="cust.name"></p>
                                <p style="font-size:10px;color:#64748b;margin:1px 0 0;font-weight:600;" x-text="cust.phone"></p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Selected Customer badge -->
                <div x-show="selectedCustomer" style="margin-top:8px;padding:8px 12px;background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;display:flex;align-items:center;justify-content:space-between;">
                    <div style="display:flex;flex-direction:column;gap:1px;">
                        <span style="font-size:13px;font-weight:800;color:#1e40af;" x-text="selectedCustomer?.name"></span>
                        <span style="font-size:11px;color:#3b82f6;font-weight:600;" x-text="selectedCustomer?.phone"></span>
                    </div>
                    <span style="font-size:10px;font-weight:900;background:#dbeafe;color:#1d4ed8;padding:4px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:0.05em;">Selected ✓</span>
                </div>

                <!-- Walk-in notice -->
                <div x-show="!selectedCustomer" style="margin-top:6px;font-size:11px;color:#d97706;font-weight:700;">
                    Walk-in customer. Search or create a new one above.
                </div>
            </div>

            <!-- Cart -->
            <div style="flex:1;overflow-y:auto;padding:12px 16px;background:#f8fafc;display:flex;flex-direction:column;gap:8px;">
                <template x-if="cart.length === 0">
                    <div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a3b8;padding:20px 0;">
                        <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="opacity:0.3;margin-bottom:8px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <p style="font-size:12px;font-weight:800;margin:0;">No items added</p>
                    </div>
                </template>

                <template x-for="(item, index) in cart" :key="index">
                    <div style="background:white;padding:12px 16px;border-radius:14px;border:1px solid #e2e8f0;box-shadow:0 1px 4px rgba(0,0,0,0.03);display:flex;align-items:center;justify-content:space-between;gap:12px;">
                        <!-- Left Side: Name and Price -->
                        <div style="flex:1;display:flex;flex-direction:column;gap:2px;">
                            <div style="display:flex;align-items:center;gap:6px;">
                                <h4 style="font-size:12px;font-weight:800;color:#0f172a;margin:0;" x-text="item.name"></h4>
                                <button @click="removeFromCart(index)" style="background:none;border:none;cursor:pointer;color:#fca5a5;padding:0;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#fca5a5'">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                </button>
                            </div>
                            <span style="font-size:10px;color:#64748b;font-weight:700;" x-text="'Rs.' + parseFloat(item.base_price).toFixed(2) + (item.price_type === 'per_kg' ? ' /kg' : ' /item')"></span>
                        </div>

                        <!-- Right Side: Quantity and Total -->
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div style="display:flex;align-items:center;background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:8px;overflow:hidden;">
                                <button @click="updateQty(index,-1)" style="padding:4px 8px;background:none;border:none;cursor:pointer;font-size:14px;font-weight:900;color:#64748b;">−</button>
                                <input type="number" x-model.number="item.qty" style="width:36px;text-align:center;font-size:12px;font-weight:800;border:none;outline:none;padding:4px 0;background:white;color:#0f172a;" min="0.5" step="0.5">
                                <button @click="updateQty(index,1)"  style="padding:4px 8px;background:none;border:none;cursor:pointer;font-size:14px;font-weight:900;color:#64748b;">+</button>
                            </div>
                            <span style="font-size:14px;font-weight:900;color:#1d4ed8;min-width:65px;text-align:right;" x-text="'Rs.' + (item.base_price * item.qty).toFixed(2)"></span>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Checkout Button Summary -->
            <div style="padding:16px;border-top:1px solid #f1f5f9;background:white;">
                <button @click="showCheckoutModal = true" :disabled="cart.length === 0"
                    :style="cart.length === 0 ? 'background:#94a3b8;cursor:not-allowed;' : 'background:#1d4ed8;cursor:pointer;box-shadow:0 4px 14px rgba(29,78,216,0.35);'"
                    style="width:100%;padding:14px 16px;color:white;font-size:15px;font-weight:900;border:none;border-radius:12px;transition:all 0.15s;display:flex;align-items:center;justify-content:space-between;letter-spacing:0.02em;"
                    onmouseover="if(this.style.background!=='rgb(148, 163, 184)') this.style.transform='scale(1.01)'"
                    onmouseout="if(this.style.background!=='rgb(148, 163, 184)') this.style.transform='scale(1)'">
                    <span style="display:flex;align-items:center;gap:8px;">
                        Proceed to Checkout
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                    <span style="background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:8px;" x-text="'Rs. ' + subtotal.toFixed(2)"></span>
                </button>
            </div>
        </div>

        <!-- ===================== Checkout Modal ===================== -->
        <div x-show="showCheckoutModal" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
            <div class="absolute inset-0 bg-black bg-opacity-60 backdrop-blur-sm" @click="showCheckoutModal = false"></div>
            <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md z-10 flex flex-col overflow-hidden" @click.stop>
                <div class="p-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h3 class="font-black text-lg text-gray-800">Checkout</h3>
                    <button @click="showCheckoutModal = false" class="text-gray-400 hover:text-gray-600">
                        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                
                <div class="p-5 space-y-4">
                    <!-- Subtotal & Discount row -->
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Subtotal</p>
                            <p class="text-base font-black text-gray-800" x-text="'Rs. ' + subtotal.toFixed(2)"></p>
                        </div>
                        
                        <div class="text-right">
                            <p class="text-xs font-bold text-gray-500 mb-1 uppercase tracking-wide">Discount</p>
                            <div class="flex items-center gap-2">
                                <select x-model="discountType" class="text-xs border-gray-200 rounded-lg p-1.5 focus:border-blue-500 focus:ring-blue-500 font-bold outline-none bg-gray-50">
                                    <option value="fixed">Rs.</option>
                                    <option value="percent">%</option>
                                </select>
                                <input type="number" x-model.number="discountValue" class="w-16 text-right text-sm border-gray-200 rounded-lg p-1.5 focus:border-blue-500 focus:ring-blue-500 font-black outline-none" min="0">
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-gray-100 my-1"></div>

                    <!-- Pickup Date -->
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wide">Pickup Date</span>
                        <input type="datetime-local" x-model="dueDate" class="text-xs border-gray-200 rounded-lg p-1.5 focus:border-blue-500 focus:ring-blue-500 font-bold outline-none text-gray-800">
                    </div>

                    <div class="border-t border-gray-100 my-1"></div>

                    <!-- Total -->
                    <div class="flex justify-between items-center py-1">
                        <span class="text-lg font-black text-gray-800">Total</span>
                        <span class="text-2xl font-black text-blue-700" x-text="'Rs. ' + total.toFixed(2)"></span>
                    </div>

                    <!-- Payment Methods (Side by Side) -->
                    <div class="pt-2">
                        <p class="text-xs font-bold text-gray-500 mb-2 uppercase tracking-wide">Payment Method</p>
                        <div class="flex gap-3">
                            <button @click="paymentMode = 'pay_now'"
                                :class="paymentMode === 'pay_now' ? 'border-green-500 bg-green-50 ring-2 ring-green-200' : 'border-gray-200 bg-white hover:bg-gray-50'"
                                class="flex-1 flex flex-col items-center justify-center p-3 border-2 rounded-xl transition-all cursor-pointer">
                                <div :class="paymentMode === 'pay_now' ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-500'" class="w-7 h-7 rounded-full flex items-center justify-center transition-colors mb-1">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <span class="font-black text-gray-800 text-sm">Pay Now</span>
                            </button>

                            <button @click="paymentMode = 'pay_on_pickup'"
                                :class="paymentMode === 'pay_on_pickup' ? 'border-orange-500 bg-orange-50 ring-2 ring-orange-200' : 'border-gray-200 bg-white hover:bg-gray-50'"
                                class="flex-1 flex flex-col items-center justify-center p-3 border-2 rounded-xl transition-all cursor-pointer">
                                <div :class="paymentMode === 'pay_on_pickup' ? 'bg-orange-500 text-white' : 'bg-gray-200 text-gray-500'" class="w-7 h-7 rounded-full flex items-center justify-center transition-colors mb-1">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <span class="font-black text-gray-800 text-sm">Pay on Pickup</span>
                            </button>
                        </div>
                        
                        <!-- Sub options for Pay Now -->
                        <div x-show="paymentMode === 'pay_now'" class="flex gap-2 mt-3 bg-gray-50 p-2 rounded-lg border border-gray-100">
                            <button @click.stop="paymentMethod = 'cash'" :class="paymentMethod === 'cash' ? 'bg-green-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200'" class="flex-1 px-3 py-2 rounded-lg text-xs font-black transition-all">💵 CASH</button>
                            <button @click.stop="paymentMethod = 'card'" :class="paymentMethod === 'card' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200'" class="flex-1 px-3 py-2 rounded-lg text-xs font-black transition-all">💳 CARD</button>
                        </div>
                    </div>

                    <!-- Confirm Order Button -->
                    <div class="pt-2">
                        <button @click="placeOrder" 
                            class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white text-base font-black rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2">
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Confirm Order
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================== Add New Customer Modal ===================== -->
    <div x-data="{ open: false }"
         x-on:open-customer-modal.window="open = true"
         x-on:close-customer-modal.window="open = false"
         x-show="open" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
        <div class="absolute inset-0 bg-black bg-opacity-40 backdrop-blur-sm" @click="open = false"></div>
        <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md z-10" @click.stop>
            <div class="p-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                <div>
                    <h3 class="font-black text-gray-800 text-base">Add New Customer</h3>
                </div>
                <button @click="open = false" class="text-gray-400 hover:text-gray-600">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form id="new-customer-form" class="p-5 space-y-3">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="nc-name" required placeholder="e.g. Kamal Perera" class="w-full text-sm border-gray-200 rounded-lg p-2 focus:border-blue-500 focus:ring-blue-500 bg-gray-50 font-semibold">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Phone Number</label>
                    <input type="text" id="nc-phone" required placeholder="e.g. 077 123 4567" class="w-full text-sm border-gray-200 rounded-lg p-2 focus:border-blue-500 focus:ring-blue-500 bg-gray-50 font-semibold">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Address (Optional)</label>
                    <input type="text" id="nc-address" placeholder="Home address" class="w-full text-sm border-gray-200 rounded-lg p-2 focus:border-blue-500 focus:ring-blue-500 bg-gray-50 font-semibold">
                </div>
            </form>
            <div class="flex gap-2 p-4 pt-0 bg-gray-50 rounded-b-2xl">
                <button @click="open = false" class="flex-1 py-2 border-2 border-gray-200 text-gray-600 font-black rounded-xl hover:bg-gray-100 transition-colors text-sm">Cancel</button>
                <button @click="createAndSelectCustomer(open)" id="save-customer-btn"
                    class="flex-1 py-2 bg-green-600 hover:bg-green-700 text-white font-black rounded-xl shadow-md hover:shadow-lg transition-all text-sm">
                    Save Customer
                </button>
            </div>
        </div>
    </div>

    <!-- ===================== Order Success Modal ===================== -->
    <div x-data="{ show: false, orderId: '', orderNum: '', custName: '', total: '', payMode: '' }"
         x-on:order-placed.window="show = true; orderId = $event.detail.orderId; orderNum = $event.detail.orderNumber; custName = $event.detail.customerName; total = $event.detail.total; payMode = $event.detail.paymentMode"
         x-show="show" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
        <div class="absolute inset-0 bg-black bg-opacity-60 backdrop-blur-sm"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm z-10 text-center p-6" @click.stop>
            <div class="w-14 h-14 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-inner">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-1">Order Placed!</h3>
            <p class="text-xs text-gray-500 mb-5 font-bold">The laundry order has been registered successfully.</p>

            <div class="bg-gray-50 border border-gray-100 rounded-xl p-4 text-left space-y-2 mb-5 text-sm shadow-sm">
                <div class="flex justify-between items-center">
                    <span class="text-gray-500 font-bold text-xs uppercase">Order #:</span>
                    <span class="font-black text-blue-700 text-sm" x-text="orderNum"></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-500 font-bold text-xs uppercase">Customer:</span>
                    <span class="font-black text-gray-800" x-text="custName"></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-500 font-bold text-xs uppercase">Total:</span>
                    <span class="font-black text-green-700 text-sm" x-text="'Rs. ' + total"></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-500 font-bold text-xs uppercase">Payment:</span>
                    <span class="font-black text-gray-800" x-text="payMode === 'pay_now' ? 'Paid (Cash/Card)' : 'Pay on Pickup'"></span>
                </div>
            </div>

            <button @click="show = false" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-black rounded-xl shadow-lg hover:shadow-xl transition-all">✓ Create New Order</button>
        </div>
    </div>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('posSystem', () => ({
                allServices: @json($services),
                allCustomers: @json($customers),
                searchQuery: '',
                customerSearch: '',
                filteredCustomers: [],
                showCustDropdown: false,
                selectedCustomer: null,
                cart: [],
                
                showCheckoutModal: false,
                discountType: 'fixed',
                discountValue: 0,
                paymentMode: 'pay_now',
                paymentMethod: 'cash',
                dueDate: '',

                get filteredServices() {
                    if (!this.searchQuery) return this.allServices;
                    return this.allServices.filter(s => s.name.toLowerCase().includes(this.searchQuery.toLowerCase()));
                },

                filterCustomers() {
                    const q = this.customerSearch.toLowerCase();
                    this.filteredCustomers = q.length > 0
                        ? this.allCustomers.filter(c => c.name.toLowerCase().includes(q) || c.phone.includes(q))
                        : this.allCustomers.slice(0, 8);
                    this.showCustDropdown = true;
                },

                selectCustomer(cust) {
                    this.selectedCustomer = cust;
                    this.customerSearch = '';
                    this.showCustDropdown = false;
                },

                clearCustomer() {
                    this.selectedCustomer = null;
                    this.customerSearch = '';
                },

                addToCart(service) {
                    let existing = this.cart.find(i => i.id === service.id);
                    if (existing) { existing.qty += 1; } else { this.cart.push({ ...service, qty: 1 }); }
                },

                removeFromCart(index) { this.cart.splice(index, 1); },

                updateQty(index, change) {
                    let newQty = parseFloat(this.cart[index].qty) + change;
                    if (newQty > 0) this.cart[index].qty = Math.round(newQty * 10) / 10;
                    else this.removeFromCart(index);
                },

                get subtotal() { return this.cart.reduce((s, i) => s + (i.base_price * i.qty), 0); },
                
                get calculatedDiscount() {
                    let val = parseFloat(this.discountValue) || 0;
                    if (this.discountType === 'percent') {
                        return this.subtotal * (val / 100);
                    }
                    return val;
                },
                
                get total() { return Math.max(0, this.subtotal - this.calculatedDiscount); },

                async placeOrder() {
                    if (this.cart.length === 0) return;

                    const payload = {
                        customer_id: this.selectedCustomer ? this.selectedCustomer.id : null,
                        new_customer_name: this.selectedCustomer ? null : 'Walk-in',
                        new_customer_phone: this.selectedCustomer ? null : '0000000000',
                        cart: this.cart,
                        discount: this.calculatedDiscount,
                        payment_mode: this.paymentMode,
                        payment_method: this.paymentMethod,
                        due_date: this.dueDate
                    };

                    try {
                        const res = await fetch("{{ route('pos.store') }}", {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                            },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.showCheckoutModal = false;
                            window.dispatchEvent(new CustomEvent('order-placed', { detail: {
                                orderId: data.order_id,
                                orderNumber: data.order_number,
                                customerName: data.customer_name,
                                total: this.total.toFixed(2),
                                paymentMode: this.paymentMode
                            }}));
                            this.cart = [];
                            this.selectedCustomer = null;
                            this.discountValue = 0;
                            this.paymentMode = 'pay_now';
                            this.paymentMethod = 'cash';
                            this.dueDate = '';
                        } else {
                            alert('Order failed: ' + (data.error || 'Unknown error'));
                        }
                    } catch (err) { console.error(err); alert('Network error. Please try again.'); }
                },

                init() {
                    window.posAddCustomer = (customer) => {
                        this.allCustomers.push(customer);
                        this.selectCustomer(customer);
                    };
                }
            }));
        });

        document.getElementById('save-customer-btn').addEventListener('click', async function() {
            const name = document.getElementById('nc-name').value.trim();
            const phone = document.getElementById('nc-phone').value.trim();
            const address = document.getElementById('nc-address').value.trim();

            if (!name || !phone) { alert('Name and phone are required.'); return; }

            const res = await fetch("{{ route('customers.store.pos') }}", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content },
                body: JSON.stringify({ name, phone, address, source: 'pos' })
            });
            const data = await res.json();
            if (data.success) {
                window.posAddCustomer(data.customer);
                document.getElementById('nc-name').value = '';
                document.getElementById('nc-phone').value = '';
                document.getElementById('nc-address').value = '';
                window.dispatchEvent(new Event('close-customer-modal'));
            } else {
                alert('Failed to save customer.');
            }
        });
    </script>
</x-app-layout>
